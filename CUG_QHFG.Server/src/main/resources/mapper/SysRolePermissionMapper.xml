<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cug.qhfg.mapper.SysRolePermissionMapper">

    <resultMap id="BaseResultMap" type="com.cug.qhfg.entity.SysRolePermission">
            <id property="id" column="id" jdbcType="INTEGER"/>
            <result property="role" column="role" jdbcType="VARCHAR"/>
            <result property="permission" column="permission" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,role,permission
    </sql>
    <select id="selectRolePermissionByUsername" resultType="java.lang.String">
        SELECT rp.permission
        FROM sys_role_permission rp
                 JOIN (
            SELECT role
            FROM sys_user
            WHERE username = #{username}
        ) AS subquery ON rp.role = subquery.role;
    </select>

</mapper>
